diff --git a/android_world/env/android_world_controller.py b/android_world/env/android_world_controller.py
--- a/android_world/env/android_world_controller.py
+++ b/android_world/env/android_world_controller.py
@@ -25,6 +25,7 @@ from absl import logging
 from android_env import env_interface
 from android_env import loader
 from android_env.components import config_classes
+from android_env.proto import adb_pb2
 from android_env.proto.a11y import android_accessibility_forest_pb2
 from android_env.wrappers import a11y_grpc_wrapper
 from android_env.wrappers import base_wrapper
@@ -140,13 +141,63 @@ class A11yMethod(enum.Enum):
 def apply_a11y_forwarder_app_wrapper(
     env: env_interface.AndroidEnvInterface, install_a11y_forwarding_app: bool
 ) -> env_interface.AndroidEnvInterface:
-  return a11y_grpc_wrapper.A11yGrpcWrapper(
+  wrapped_env = a11y_grpc_wrapper.A11yGrpcWrapper(
       env,
       install_a11y_forwarding=install_a11y_forwarding_app,
       start_a11y_service=True,
       enable_a11y_tree_info=True,
       latest_a11y_info_only=True,
   )
+  # When AndroidEnv connects to an already-running emulator, its relaunch
+  # counter remains zero.  A11yGrpcWrapper.reset() therefore skips
+  # _configure_grpc(), leaving the on-device forwarder pointed at the random
+  # host port used by an earlier (now dead) Python process.  Explicitly enable
+  # the service and publish this wrapper's current host/port on every new
+  # connection.
+  enable_response = wrapped_env.execute_adb_call(
+      adb_pb2.AdbRequest(
+          settings=adb_pb2.AdbRequest.SettingsRequest(
+              name_space=adb_pb2.AdbRequest.SettingsRequest.Namespace.SECURE,
+              put=adb_pb2.AdbRequest.SettingsRequest.Put(
+                  key='accessibility_enabled', value='1'
+              ),
+          )
+      )
+  )
+  if (
+      isinstance(enable_response, adb_pb2.AdbResponse)
+      and enable_response.status != adb_pb2.AdbResponse.Status.OK
+  ):
+    raise RuntimeError(
+        'Could not enable accessibility service: '
+        f'{enable_response}.'
+    )
+
+  # A Wi-Fi benchmark may intentionally disable the guest's networking.  If
+  # the forwarder uses a normal guest-to-host TCP route, that also cuts off the
+  # accessibility tree that the agent needs for its next observation.  For a
+  # loopback gRPC host, carry the connection over ADB instead; adb reverse is
+  # independent of the emulated Wi-Fi and remains available while Wi-Fi is off.
+  # pylint: disable=protected-access
+  grpc_host = wrapped_env._grpc_host
+  grpc_port = wrapped_env._port
+  # pylint: enable=protected-access
+  if grpc_host in ('127.0.0.1', 'localhost'):
+    reverse_response = adb_utils.issue_generic_request(
+        [
+            'reverse',
+            f'tcp:{grpc_port}',
+            f'tcp:{grpc_port}',
+        ],
+        wrapped_env,
+    )
+    if reverse_response.status != adb_pb2.AdbResponse.Status.OK:
+      raise RuntimeError(
+          'Could not configure the ADB reverse tunnel for accessibility: '
+          f'{reverse_response}.'
+      )
+  wrapped_env._configure_grpc()  # pylint: disable=protected-access
+  return wrapped_env
 
 
 class AndroidWorldController(base_wrapper.BaseWrapper):
